<Window x:Class="aplikacjadesktopowa7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:aplikacjadesktopowa7"
        mc:Ignorable="d"
        Title="Dodaj Pracownika" Height="450" Width="800">
    <Grid Background="LightSteelBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="27*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Dane pracownika" Margin="44,78,183,72">

        </GroupBox>
        <Label Content="Imię" RenderTransformOrigin="0.425,0.462" Margin="62,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <TextBox Name="imie" VerticalAlignment="Top" Width="156" Height="31" Margin="111,115,263,0" />
        <Label Content="Nazwisko
               " Margin="51,184,0,217" HorizontalAlignment="Left"/>
        <TextBox Name="nazwisko"  VerticalAlignment="Top" Width="156" Height="31" Margin="113,181,261,0" />
        <Label Content="Stanowisko" Margin="67,268,0,133" HorizontalAlignment="Left"/>
        <ComboBox Name="stanowisko" SelectedValuePath="Content" HorizontalAlignment="Left" Margin="135,270,0,0" VerticalAlignment="Top" Width="120">

            <ComboBoxItem>Kierownik</ComboBoxItem>
            <ComboBoxItem >Starszy programista</ComboBoxItem>
            <ComboBoxItem>Młodszy programista</ComboBoxItem>
            <ComboBoxItem>Tester</ComboBoxItem>

        </ComboBox>
        <GroupBox Header="Generowanie hasła" Margin="443,71,54,79" Grid.ColumnSpan="2"/>
        <Label Content="Ile znaków?" RenderTransformOrigin="0.425,0.462" Margin="464,121,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="79" Grid.ColumnSpan="2"/>
        <TextBox x:Name="textBoxIlosc" VerticalAlignment="Top" Width="156" Height="31" Margin="32,117,82,0" Grid.Column="1" />
        <CheckBox Name="IfWielkie" Content="Małe i wielkie litery&#xD;&#xA;" HorizontalAlignment="Left" Margin="468,190,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <CheckBox Name="IfCyfry" Content="Cyfry&#xD;&#xA;" HorizontalAlignment="Left" Margin="468,221,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <CheckBox Name="IfZnaki" Content="Znaki specjalne&#xD;&#xA;" HorizontalAlignment="Left" Margin="468,254,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <Button Grid.Column="1" Content="Generuj Hasło" HorizontalAlignment="Left" Margin="34,322,0,0" VerticalAlignment="Top" Background="SteelBlue" Foreground="White" BorderBrush="White" Click="Button_Click"/>
        <Button Content="Zatwierdz" HorizontalAlignment="Left" Margin="330,397,0,0" VerticalAlignment="Top" Background="SteelBlue" Foreground="White" BorderBrush="White" Width="86" Click="Button_Click_1"/>
        <Label Content="Nazwisko" RenderTransformOrigin="0.425,0.462" Margin="52,187,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="Stanowisko" RenderTransformOrigin="0.425,0.462" Margin="68,270,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

    </Grid>
</Window>
